// NOTE: This project uses Turso (libSQL / SQLite-compatible) instead of a local SQLite file.
// WHY: Vercel's production filesystem is ephemeral and read-only — any local .db file
//      would be reset to zero on every new deployment. Turso uses the exact same SQLite
//      syntax and the same Prisma workflow (migrations, prisma studio, etc.) but the data
//      lives in a persistent cloud database, so registrations are NEVER wiped on redeploy.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// IMPORTANT: No cascade deletes, no auto-cleanup, no cron jobs anywhere in this codebase.
// Registrations are ONLY ever deleted if an admin explicitly clicks a delete button
// (which is not implemented by default — all data is retained permanently).
model Registration {
  id         String   @id @default(cuid())
  name       String
  fatherName String
  phone      String
  cnic       String
  address    String
  course     String
  status     String   @default("pending") // "pending" | "confirmed"
  createdAt  DateTime @default(now())
}
