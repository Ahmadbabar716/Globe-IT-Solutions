# .env.local — copy this file to .env.local and fill in your real values
# DO NOT commit .env.local to git — it is already in .gitignore

# -----------------------------------------------------------------------
# Turso (libSQL) — persistent SQLite-compatible cloud database
# WHY TURSO: Vercel's production filesystem is ephemeral and read-only.
# A local .db file resets on every deploy. Turso keeps the same SQLite
# syntax but persists data permanently in the cloud.
# -----------------------------------------------------------------------

# Your Turso database URL (from: turso db show --url <db-name>)
DATABASE_URL=libsql://your-db-name-your-org.turso.io

# Your Turso auth token (from: turso db tokens create <db-name>)
DATABASE_AUTH_TOKEN=your-turso-auth-token-here

# -----------------------------------------------------------------------
# Admin Dashboard
# -----------------------------------------------------------------------

# The password to log in to /admin (choose something strong)
ADMIN_PASSWORD=your-secret-admin-password-here
